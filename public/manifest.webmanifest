{
  "name": "Napkin Math",
  "short_name": "Napkin Math",
  "description": "Paste a real estate listing link and underwrite the deal: cash flow, cap rate, 5-year returns, due diligence and financing.",
  "start_url": "/app/#import",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#1C2230",
  "theme_color": "#1C2230",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "/app/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
